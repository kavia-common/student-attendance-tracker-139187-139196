# Server
PORT=3001
HOST=0.0.0.0
CORS_ORIGIN=*

# JWT (used by current local auth; may be replaced by Supabase Auth later)
JWT_SECRET=change-me
TOKEN_EXPIRES_IN=1d

# Database (optional; if empty app uses in-memory repo)
# Example for PostgreSQL client:
# DB_CLIENT=pg
# DB_HOST=localhost
# DB_PORT=5432
# DB_USER=postgres
# DB_PASSWORD=postgres
# DB_NAME=student_attendance

# Supabase (for future integration / optional now)
# NOTE: Do NOT commit real secrets.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_KEY=

# Site URLs for auth redirects (if using Supabase Auth)
# NEXT_PUBLIC_SITE_URL or REACT_APP_SITE_URL can be set on frontend; backend can use SITE_URL if needed.
SITE_URL=http://localhost:3000
