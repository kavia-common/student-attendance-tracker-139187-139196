# Server
PORT=3001
HOST=0.0.0.0
NODE_ENV=development
JWT_SECRET=replace-with-strong-secret
TOKEN_EXPIRES_IN=1d
CORS_ORIGIN=*

# Database (student_attendance_database)
DB_CLIENT=postgres
DB_HOST=localhost
DB_PORT=5432
DB_USER=attendance_user
DB_PASSWORD=attendance_password
DB_NAME=attendance_db
DB_SSL=false

# Supabase (optional future integration)
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_KEY=
