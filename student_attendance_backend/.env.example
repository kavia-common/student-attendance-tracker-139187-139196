# Server
PORT=3001
HOST=0.0.0.0
NODE_ENV=development
CORS_ORIGIN=*

# Auth (local JWT)
JWT_SECRET=please-change-me
TOKEN_EXPIRES_IN=1d

# Database configuration (choose one: URL form or discrete fields)
# Option A: Single connection URL (preferred in many environments)
# Examples:
#   Postgres: postgres://USER:PASSWORD@HOST:PORT/DBNAME?sslmode=require
#   MySQL:    mysql://USER:PASSWORD@HOST:PORT/DBNAME
# DB_URL=

# Option B: Discrete fields
# Supported clients: pg, mysql2, better-sqlite3 (ensure driver installed when used)
DB_CLIENT=pg
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=attendance
# Set DB_SSL=true when connecting to managed Postgres with SSL (e.g., Supabase)
DB_SSL=false

# Supabase (optional, for future integration)
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
SUPABASE_ANON_KEY=
SITE_URL=http://localhost:3000
